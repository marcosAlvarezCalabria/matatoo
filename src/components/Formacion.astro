---
import { LINKS } from '../data/site';
---
<section id="formacion" class="dark">
  <div class="wrap sec stack" style="gap:56px">
    <div class="stack" style="gap:16px">
      <div class="kicker">Para tatuadores</div>
      <h2 class="h2" data-reveal data-from="left" style="font-size:clamp(40px,5vw,72px);line-height:.95;max-width:18ch">Gana más trabajando menos horas, sin bajar calidad</h2>
    </div>
    <div class="cards">
      <div>
        <span class="meta">30 y 31 oct · 1 nov · Madrid</span>
        <h3>Seminario de realismo</h3>
        <p>Tres días presenciales. 10 plazas. Escribe «SEMINARIO» por Instagram.</p>
        <a href={LINKS.igDm} target="_blank" rel="noopener" class="btn btn-white">Pedir info ↗</a>
      </div>
      <div>
        <span class="meta">Gratis · WhatsApp</span>
        <h3>Comunidad de tatuadores</h3>
        <p>Consejos, dudas y comunidad para tatuadores de realismo.</p>
        <a href={LINKS.comunidad} target="_blank" rel="noopener" class="btn btn-wline">Unirme ↗</a>
      </div>
    </div>
  </div>
</section>
